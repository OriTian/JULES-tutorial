! NOTE: &jules_time and &jules_spinup are read from a file HARD-CODED as
! "timesteps.nml" by the JULES source, regardless of what your other
! namelist files are named. A leftover jules_time.nml elsewhere is never
! read and will not error.
&jules_time
  l_360=.false.
  l_leap=.true.
  l_local_solar_time=.false.
  main_run_start='${MAIN_RUN_START}'   ! after your spin-up period
  main_run_end='${MAIN_RUN_END}'
  print_step=48
  timestep_len=3600
/

&jules_spinup
  max_spinup_cycles=0   ! spin-up here = starting data_start earlier
                          ! than main_run_start, not a separate cycle count
/
